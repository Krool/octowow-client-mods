	<!-- Octo templates: buttons built purely in Lua do not render in this
	     glue VM (template-inherited ones do), so the reorder arrows and
	     challenge icons inherit these. -->
	<Button name="OctoChalIconTemplate" virtual="true">
		<Size><AbsDimension x="16" y="16"/></Size>
		<Layers>
			<Layer level="BACKGROUND">
				<!-- Stock gold quickslot ring (same treatment as the paperdoll
				     addon's icons). Anchored with fixed insets so it scales
				     when Sel_EnsureIcon resizes the button to 32px: 16px icon
				     -> 28px ring, 32px icon -> 44px ring. -->
				<Texture name="$parentRing" file="Interface\Buttons\UI-Quickslot2">
					<Anchors>
						<Anchor point="TOPLEFT"><Offset><AbsDimension x="-6" y="6"/></Offset></Anchor>
						<Anchor point="BOTTOMRIGHT"><Offset><AbsDimension x="6" y="-6"/></Offset></Anchor>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD"/>
	</Button>
	<!-- Status lamp (v27): round ring + fill from the stock radio-button
	     sprite sheet (quarters: 0-.25 ring outline, .5-.75 white fill glow);
	     OctoGlue tints $parentFill green/yellow/red by verdict. -->
	<Button name="OctoStatusDotTemplate" virtual="true">
		<Size><AbsDimension x="16" y="16"/></Size>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentRing" file="Interface\Buttons\UI-RadioButton">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
					<TexCoords left="0" right="0.25" top="0" bottom="1"/>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture name="$parentFill" file="Interface\Buttons\UI-RadioButton">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
					<TexCoords left="0.5" right="0.75" top="0" bottom="1"/>
				</Texture>
			</Layer>
		</Layers>
		<HighlightTexture file="Interface\Buttons\UI-RadioButton" alphaMode="ADD">
			<TexCoords left="0.5" right="0.75" top="0" bottom="1"/>
		</HighlightTexture>
	</Button>
